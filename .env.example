# PayPal sandbox app credentials
PAYPAL_CLIENT_ID=replace-with-your-sandbox-client-id
PAYPAL_CLIENT_SECRET=replace-with-your-sandbox-client-secret
PAYPAL_ENV=sandbox

# Base URL only; the payment service appends /sessions/current
AUTH_SERVICE_URL=http://localhost:9000

# Comma-separated frontend origins, including scheme and port
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Payment service listen port
PORT=8080
